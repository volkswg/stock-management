{
  "base": "5d01209f9c241a5c6b4f07702b9684e7e2a2f79a",
  "files": {
    "src/modules/orders/server.ts": {
      "source": "import \"server-only\";\nimport type { IGoogleSheetsService } from \"@/externals/google/sheet\";\nimport { createSortableId } from \"@/services/utils/createSortableId\";\nimport type { CreatedOrder, OrderListItem, OrderDetail } from \"./contracts\";\nimport { createOrder as executeCreateOrder, type CreateOrderInput } from \"./application/create-order\";\nimport { listOrders as executeListOrders } from \"./application/list-orders\";\nimport { GoogleSheetsOrderListReader } from \"./infrastructure/google-sheets/order-list-reader\";\nimport { GoogleSheetsOrderWriter } from \"./infrastructure/google-sheets/order-writer\";\n\nimport { getOrderDetail as executeGetOrderDetail } from \"./application/get-order-detail\";\nimport type { OrderDetailShipmentProjectionReader } from \"./application/ports/order-detail-shipment-projection\";\nimport { GoogleSheetsOrderDetailReader } from \"./infrastructure/google-sheets/order-detail-reader\";\n\n// Existing server callers keep passing the existing service. Only this\n// composition boundary knows the concrete adapter, clock and ID generator.\nexport async function listOrders({\n  googleSheetsService,\n}: { googleSheetsService: IGoogleSheetsService }): Promise<OrderListItem[]> {\n  return executeListOrders(new GoogleSheetsOrderListReader(googleSheetsService));\n}\n\nexport async function createOrder({\n  googleSheetsService, id, seller, totalPrice, remark, createdBy,\n}: CreateOrderInput & { googleSheetsService: IGoogleSheetsService }): Promise<CreatedOrder> {\n  return executeCreateOrder({ id, seller, totalPrice, remark, createdBy }, {\n    writer: new GoogleSheetsOrderWriter(googleSheetsService),\n    now: () => new Date().toISOString(),\n    createId: createSortableId,\n  });\n}\n\nexport async function getOrderDetail({\n  googleSheetsService,\n  orderId,\n  shipmentProjection,\n}: {\n  googleSheetsService: IGoogleSheetsService;\n  orderId: string;\n  shipmentProjection: OrderDetailShipmentProjectionReader;\n}): Promise<OrderDetail | undefined> {\n  return await executeGetOrderDetail(new GoogleSheetsOrderDetailReader(googleSheetsService), shipmentProjection, orderId);\n}\n",
      "sha256": "1a16141bf3fd0459aa6d060d8169257752b15f6397c013420826e43242f016c2"
    },
    "src/modules/orders/infrastructure/google-sheets/order-row-mapping.ts": {
      "source": "import \"server-only\";\nimport type { GoogleSheetCellValue, GoogleSheetRow } from \"@/externals/google/sheet\";\nimport { OrderStatus, type OrderListItem, type OrderProductImage } from \"../../contracts\";\n\nexport function mapOrderRow(row: GoogleSheetRow): OrderListItem | undefined {\n  const [\n    id,\n    status,\n    seller,\n    totalPrice,\n    remark,\n    createdAt,\n    updatedAt,\n    deletedAt,\n    createdBy,\n  ] = row;\n\n  const normalizedId = toStringValue(id);\n  const normalizedStatus = toStringValue(status);\n  if (\n    !normalizedId ||\n    !isOrderStatus(normalizedStatus) ||\n    toStringValue(deletedAt)\n  ) {\n    return undefined;\n  }\n\n  return {\n    id: normalizedId,\n    status: normalizedStatus,\n    seller: toStringValue(seller),\n    totalPrice: toPrice(totalPrice),\n    remark: toStringValue(remark),\n    createdAt: toStringValue(createdAt),\n    updatedAt: toStringValue(updatedAt),\n    createdBy: toStringValue(createdBy),\n    shipmentId: null,\n    productImages: [],\n  };\n}\n\nexport function mapOrderProductImageRow(\n  row: GoogleSheetRow,\n): OrderProductImage | undefined {\n  const [\n    id,\n    orderId,\n    imageUrl,\n    quoteQuantity,\n    deliveredQuantity,\n    productCode,\n    createdAt,\n    ,\n    deletedAt,\n  ] = row;\n  const normalizedId = toStringValue(id);\n  const normalizedOrderId = toStringValue(orderId);\n  const normalizedImageUrl = toStringValue(imageUrl);\n  if (\n    !normalizedId ||\n    !normalizedOrderId ||\n    !normalizedImageUrl ||\n    toStringValue(deletedAt)\n  ) {\n    return undefined;\n  }\n\n  return {\n    id: normalizedId,\n    orderId: normalizedOrderId,\n    imageUrl: normalizedImageUrl,\n    quoteQuantity: toStringValue(quoteQuantity),\n    deliveredQuantity: toStringValue(deliveredQuantity),\n    productCode: toStringValue(productCode),\n    createdAt: toStringValue(createdAt),\n  };\n}\n\nexport function toStringValue(value: GoogleSheetCellValue | undefined): string {\n  if (typeof value === \"string\") {\n    return value.trim();\n  }\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    return String(value);\n  }\n  return \"\";\n}\n\nexport function toPrice(value: GoogleSheetCellValue | undefined): number | null {\n  if (typeof value === \"number\" && Number.isFinite(value)) {\n    return value;\n  }\n  if (typeof value !== \"string\" || !value.trim()) {\n    return null;\n  }\n\n  const price = Number(value.replace(/,/g, \"\"));\n  return Number.isFinite(price) ? price : null;\n}\n\nexport function isOrderStatus(value: string): value is OrderStatus {\n  return Object.values(OrderStatus).includes(value as OrderStatus);\n}\n",
      "sha256": "31cc16bc45bd823396a6ea7c5ad66ee186907df770c441379122fd2482ca48ee"
    },
    "src/modules/orders/infrastructure/google-sheets/order-writer.ts": {
      "source": "import \"server-only\";\nimport type { IGoogleSheetsService } from \"@/externals/google/sheet\";\nimport { lastColumnLetter } from \"@/externals/google/sheet/const\";\nimport { ORDERS_SHEET_HEADERS } from \"@/externals/google/sheet/sheets/orders/const\";\nimport type { CreatedOrder } from \"../../contracts\";\nimport type { CreatedOrderWriter } from \"../../application/ports/created-order-writer\";\n\nexport class GoogleSheetsOrderWriter implements CreatedOrderWriter {\n  constructor(private readonly sheets: Pick<IGoogleSheetsService, \"orders\">) {}\n\n  async appendCreatedOrder(order: CreatedOrder): Promise<void> {\n    await this.sheets.orders.appendRows(\n      `A:${lastColumnLetter(ORDERS_SHEET_HEADERS.length - 1)}`,\n      [[\n        order.id,\n        order.status,\n        order.seller,\n        order.totalPrice,\n        order.remark,\n        order.createdAt,\n        order.updatedAt,\n        order.deletedAt,\n        order.createdBy,\n      ]],\n    );\n  }\n}\n",
      "sha256": "1cfb6961f7c2a2b72eeedd501a24a64dd541b641ffff29376370c7639c8ca917"
    },
    "src/modules/orders/infrastructure/google-sheets/order-list-reader.ts": {
      "source": "import \"server-only\";\nimport type { GoogleSheetRow, IGoogleSheetsService } from \"@/externals/google/sheet\";\nimport type { OrderListItem, OrderProductImage } from \"../../contracts\";\nimport type { OrderListReader } from \"../../application/ports/order-list-reader\";\nimport { mapOrderRow, mapOrderProductImageRow, toStringValue } from \"./order-row-mapping\";\n\nexport class GoogleSheetsOrderListReader implements OrderListReader {\n  constructor(private readonly googleSheetsService: Pick<IGoogleSheetsService, \"orders\" | \"orderItems\" | \"shipmentOrders\">) {}\n\n  async readOrderList(): Promise<OrderListItem[]> {\n    const [orderRows, orderItemRows, shipmentOrderRows] = await Promise.all([\n      this.googleSheetsService.orders.readRows(\"A:I\"),\n      this.googleSheetsService.orderItems.readRows(),\n      this.googleSheetsService.shipmentOrders.readRows(),\n    ]);\n    const productImagesByOrderId = groupProductImagesByOrderId(orderItemRows);\n    const shipmentIdsByOrderId = groupShipmentIdsByOrderId(shipmentOrderRows);\n\n    return orderRows\n      .map(mapOrderRow)\n      .filter((order): order is OrderListItem => Boolean(order))\n      .map((order) => ({\n        ...order,\n        shipmentId: shipmentIdsByOrderId.get(order.id) ?? null,\n        productImages: productImagesByOrderId.get(order.id) ?? [],\n      }));\n  }\n}\n\nfunction groupShipmentIdsByOrderId(\n  rows: GoogleSheetRow[],\n): Map<string, string> {\n  const shipmentIdsByOrderId = new Map<string, string>();\n\n  for (const row of rows) {\n    const [, shipmentId, orderId, , , deletedAt] = row;\n    const normalizedShipmentId = toStringValue(shipmentId);\n    const normalizedOrderId = toStringValue(orderId);\n    if (\n      !normalizedShipmentId ||\n      !normalizedOrderId ||\n      toStringValue(deletedAt)\n    ) {\n      continue;\n    }\n    shipmentIdsByOrderId.set(normalizedOrderId, normalizedShipmentId);\n  }\n\n  return shipmentIdsByOrderId;\n}\n\nfunction groupProductImagesByOrderId(\n  rows: GoogleSheetRow[],\n): Map<string, OrderProductImage[]> {\n  const productImagesByOrderId = new Map<string, OrderProductImage[]>();\n\n  for (const row of rows) {\n    const productImage = mapOrderProductImageRow(row);\n    if (!productImage) {\n      continue;\n    }\n\n    const productImages = productImagesByOrderId.get(productImage.orderId) ?? [];\n    productImages.push(productImage);\n    productImagesByOrderId.set(productImage.orderId, productImages);\n  }\n\n  return productImagesByOrderId;\n}\n",
      "sha256": "d72d8bbb48ba861a46d917d0e0acc75c98f5aac70fcf79a0ab9b397338bef6b7"
    }
  },
